{
  "name": "Sprite8 — 8-direction sprite sheet generator",
  "short_name": "Sprite8",
  "description": "Turn one character sprite into a consistent 8-directional sprite sheet.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14161b",
  "theme_color": "#14161b",
  "icons": [
    { "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
